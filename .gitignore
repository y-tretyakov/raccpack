# Rust build artifacts
/target/
**/*.rs.bk

# Cargo lockfile — binary workspace policy: Cargo.lock is committed

# Environment, tokens, secrets
.env
.env.*
!.env.example
*.pem
*.key
*.age

# Den store — age-encrypted secrets, manifests, packs, staging
/den/
**/den/
/manifests/
/staging/
# ...but the core source module named `den` is source code, not a store
!crates/raccpack-core/src/den/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Node.js / pnpm (VitePress wiki)
node_modules/
wiki/.vitepress/dist/
wiki/.vitepress/cache/

# Local agent tooling (skills, locks, scratch) — never commit
.agents/
skills-lock.json
.claude/
.cursor/
.codex/
**/.DS_Store

# Local agent/dev docs — exist only on disk, never in the repo
AGENTS.md
raccpack-agent-workflow.md
raccpack-architecture-vision.md
raccpack-facade-and-den.md
raccpack-markers-detect-modularity.md
raccpack-modularity.md
raccpack-roadmap-v1.md
