{
  "$schema": "https://design-tokens.org/schema/2025.10/basic.json",
  "$description": "raccpack design tokens — single source for TUI (Ratatui) and future Desktop (CSS/TS). DTCG-shaped. Primitive → semantic. Component tokens optional and minimal.",
  "color": {
    "primitive": {
      "bg": { "$value": "#080A0D", "$type": "color", "$description": "Deep graphite background" },
      "surface": { "$value": "#0D1117", "$type": "color", "$description": "Base surface — panels, zebra rows" },
      "surface-raised": { "$value": "#131820", "$type": "color", "$description": "Raised surface — selection wash, active rows" },
      "border": { "$value": "#242B34", "$type": "color", "$description": "Borders and rules" },
      "text": { "$value": "#E6EDF3", "$type": "color", "$description": "Primary text" },
      "muted": { "$value": "#6B7785", "$type": "color", "$description": "Secondary text, hints, empty placeholders" },
      "brand-primary": { "$value": "#FF8A3D", "$type": "color", "$description": "RaccPack brand — focus / primary action / identity" },
      "brand-bright": { "$value": "#FFB454", "$type": "color", "$description": "Bright brand — hover / strong emphasis" },
      "brand-dim": { "$value": "#A65329", "$type": "color", "$description": "Dim brand — quiet brand accents" },
      "success": { "$value": "#7CCB5E", "$type": "color", "$description": "Healthy / clean / ok" },
      "warning": { "$value": "#E6B450", "$type": "color", "$description": "Warning / attention" },
      "danger": { "$value": "#F06C75", "$type": "color", "$description": "Error / destructive" },
      "info": { "$value": "#61AFEF", "$type": "color", "$description": "Technology / information" },
      "analysis": { "$value": "#C678DD", "$type": "color", "$description": "Detection / DAG / analysis" }
    },
    "semantic": {
      "bg": { "$value": "{color.primitive.bg}", "$type": "color", "$description": "App background" },
      "surface": { "$value": "{color.primitive.surface}", "$type": "color", "$description": "Cards, subtle zebra, elevated panels" },
      "surface-raised": { "$value": "{color.primitive.surface-raised}", "$type": "color", "$description": "Selected row / active sidebar wash" },
      "border": { "$value": "{color.primitive.border}", "$type": "color", "$description": "Rules, panel edges" },
      "text": { "$value": "{color.primitive.text}", "$type": "color", "$description": "Primary text" },
      "muted": { "$value": "{color.primitive.muted}", "$type": "color", "$description": "Secondary text, hints, empty placeholders" },
      "brand-primary": { "$value": "{color.primitive.brand-primary}", "$type": "color", "$description": "Brand accent — active nav, titles, focus, selection bar" },
      "brand-bright": { "$value": "{color.primitive.brand-bright}", "$type": "color", "$description": "Hover / strong brand emphasis" },
      "brand-dim": { "$value": "{color.primitive.brand-dim}", "$type": "color", "$description": "Quiet brand accents" },
      "success": { "$value": "{color.primitive.success}", "$type": "color", "$description": "Success, git clean" },
      "warning": { "$value": "{color.primitive.warning}", "$type": "color", "$description": "Warnings, loading emphasis" },
      "danger": { "$value": "{color.primitive.danger}", "$type": "color", "$description": "Errors, destructive" },
      "info": { "$value": "{color.primitive.info}", "$type": "color", "$description": "Technology / information" },
      "analysis": { "$value": "{color.primitive.analysis}", "$type": "color", "$description": "Detection / DAG" },
      "git-clean": { "$value": "{color.semantic.success}", "$type": "color", "$description": "Git repo present" },
      "git-dirty-or-absent": { "$value": "{color.semantic.muted}", "$type": "color", "$description": "Not a git repo or neutral absent mark (prefer muted over danger for absent)" }
    }
  },
  "space": {
    "primitive": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "1", "$type": "dimension", "$description": "1 cell / 4px desktop baseline unit encoding differs by platform" },
      "2": { "$value": "2", "$type": "dimension" },
      "3": { "$value": "3", "$type": "dimension" },
      "4": { "$value": "4", "$type": "dimension" },
      "6": { "$value": "6", "$type": "dimension" },
      "8": { "$value": "8", "$type": "dimension" }
    },
    "semantic": {
      "sidebar-width": { "$value": "23", "$type": "dimension", "$description": "TUI: character columns. Desktop: map to ~240px or 15rem in transform." },
      "header-height": { "$value": "1", "$type": "dimension", "$description": "TUI rows" },
      "footer-height": { "$value": "1", "$type": "dimension", "$description": "TUI rows" },
      "detail-height": { "$value": "7", "$type": "dimension", "$description": "TUI rows under project table (detail strip)" },
      "sidebar-accent-bar": { "$value": "2", "$type": "dimension", "$description": "TUI columns for active rail bar" },
      "row-accent-bar": { "$value": "1", "$type": "dimension", "$description": "TUI columns for selected table row bar" }
    }
  },
  "typography": {
    "semantic": {
      "label-emphasis": { "$value": "bold", "$type": "fontWeight", "$description": "Selected name, active nav label (TUI Modifier::BOLD / CSS 700)" },
      "label-default": { "$value": "regular", "$type": "fontWeight", "$description": "Default UI text" }
    }
  },
  "component": {
    "sidebar": {
      "item-active-bg": { "$value": "{color.semantic.surface-raised}", "$type": "color" },
      "item-active-fg": { "$value": "{color.semantic.text}", "$type": "color" },
      "item-active-bar": { "$value": "{color.semantic.brand-primary}", "$type": "color" },
      "item-inactive-fg": { "$value": "{color.semantic.muted}", "$type": "color" },
      "width": { "$value": "{space.semantic.sidebar-width}", "$type": "dimension" }
    },
    "table": {
      "row-selected-bg": { "$value": "{color.semantic.surface-raised}", "$type": "color" },
      "row-selected-bar": { "$value": "{color.semantic.brand-primary}", "$type": "color" },
      "row-selected-name-fg": { "$value": "{color.semantic.text}", "$type": "color" },
      "empty-placeholder": { "$value": "{color.semantic.muted}", "$type": "color", "$description": "Use middle-dot glyph · not hyphen-minus for empty cells" },
      "header-fg": { "$value": "{color.semantic.brand-primary}", "$type": "color" }
    },
    "detail": {
      "title-fg": { "$value": "{color.semantic.brand-primary}", "$type": "color" },
      "path-fg": { "$value": "{color.semantic.muted}", "$type": "color" },
      "height": { "$value": "{space.semantic.detail-height}", "$type": "dimension" }
    },
    "header": {
      "brand-fg": { "$value": "{color.semantic.brand-primary}", "$type": "color" },
      "root-fg": { "$value": "{color.semantic.muted}", "$type": "color" },
      "hotkey-fg": { "$value": "{color.semantic.muted}", "$type": "color" }
    },
    "footer": {
      "fg": { "$value": "{color.semantic.muted}", "$type": "color" }
    },
    "git": {
      "clean-fg": { "$value": "{color.semantic.git-clean}", "$type": "color" },
      "absent-fg": { "$value": "{color.semantic.git-dirty-or-absent}", "$type": "color" },
      "clean-glyph": { "$value": "●", "$type": "string", "$description": "Preferred over checkmark" },
      "absent-glyph": { "$value": "·", "$type": "string", "$description": "Quiet absent mark" }
    }
  },
  "meta": {
    "name": { "$value": "raccpack Visual System 2.0", "$type": "string" },
    "version": { "$value": "0.2.0", "$type": "string", "$description": "Token pack version — independent of app semver" },
    "platforms": { "$value": "tui, desktop", "$type": "string" },
    "mapping": {
      "tui": { "$value": "crates/raccpack-tui/src/theme/ — semantic color.* → Color::Rgb; space.semantic.* → layout u16", "$type": "string" },
      "desktop": { "$value": "Future: CSS variables --rp-color-accent etc. from same file via Style Directory or hand export", "$type": "string" }
    }
  }
}
